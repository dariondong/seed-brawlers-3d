{
  "name": "seed-brawlers-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "抽号（或自定义名单摇号）生成确定性 3D 小人，2~70 人同台逐轮淘汰搏斗，右侧实时显示胜率排行榜。",
  "main": "server/index.js",
